local function UpdateAntiMonitor(
    dt
)
    local humanoid =
        SafeGetHumanoid()

    if humanoid
        and humanoid ~=
        State.AntiDescarrilhadorHumanoid then

        BindAntiHumanoid(
            humanoid
        )
    end

    if not humanoid then
        CleanupAntiCurrentCart()
        UpdateAntiDescarrilhadorGui()
        return
    end

    local seated,
        cart =
        LogAntiDescarrilhadorState(
            humanoid,
            humanoid.SeatPart
        )

    if not seated
        or not cart
        or not cart.Parent then

        CleanupAntiCurrentCart()
        UpdateAntiDescarrilhadorGui()

        return
    end

    State.AntiDescarrilhadorCurrentCart =
        cart

    local referencePart =
        SafeGetPrimaryPart(
            cart
        )

    if not referencePart
        or not referencePart.Parent then

        UpdateAntiDescarrilhadorGui()

        return
    end

    local now =
        os.clock()

    if now -
        State.AntiDescarrilhadorLastScan >=
        Config.AntiDescarrilhador.SCAN_INTERVAL
        or #State.AntiDescarrilhadorWheels ==
        0 then

        State.AntiDescarrilhadorWheels =
            GetAntiDescarrilhadorWheels(
                cart,
                referencePart
            )

        State.AntiDescarrilhadorLastScan =
            now
    end

    if State.AntiDescarrilhadorEnabled then

        ApplyAntiSpeedControllers(
            cart
        )

        ApplyAntiWheelForces()

    else

        State.AntiDescarrilhadorForcesActive =
            0
    end

    if State.AntiDescarrilhadorLastGuiUpdate <=
        now -
        Config.AntiDescarrilhador.GUI_UPDATE_INTERVAL then

        State.AntiDescarrilhadorLastGuiUpdate =
            now

        UpdateAntiDescarrilhadorGui()
    end
end

