    pcall(function()
        holder =
            Instance.new(
                "Frame"
            )

        holder.Name =
            name

        holder.Size =
            size

        holder.Position =
            position

        holder.BackgroundTransparency =
            1

        holder.ZIndex =
            zIndex or 10

        holder.Parent =
            parent
    end)

    if not holder then
        return nil, nil, nil
    end

    local imageLabel
    local fallback

    pcall(function()
        imageLabel =
            Instance.new(
                "ImageLabel"
            )

        imageLabel.Name =
            "Image"

        imageLabel.Size =
            UDim2.fromScale(
                1,
                1
            )

        imageLabel.BackgroundTransparency =
            1

        imageLabel.Image =
            image or ""

        imageLabel.ScaleType =
            Enum.ScaleType.Fit

        imageLabel.ZIndex =
            zIndex or 10

        imageLabel.Parent =
            holder
    end)

    pcall(function()
        fallback =
            Instance.new(
                "TextLabel"
            )

        fallback.Name =
            "Fallback"

        fallback.Size =
            UDim2.fromScale(
                1,
                1
            )

        fallback.BackgroundTransparency =
            1

        fallback.Text =
            fallbackText or ""

        fallback.TextColor3 =
            COR_TEXTO

        fallback.Font =
            Enum.Font.GothamBold

        fallback.TextSize =
            14

        fallback.ZIndex =
            (zIndex or 10) + 1

        fallback.Parent =
            holder
    end)

    if imageLabel
        and fallback then
        fallback.Visible = false

        task.delay(
            1.5,
            function()
                pcall(function()
                    if imageLabel
                        and imageLabel.Parent
                        and not imageLabel.IsLoaded then
                        imageLabel.Visible =
                            false

                        fallback.Visible =
                            true
                    end
                end)
            end
        )

        Connect(
            imageLabel:GetPropertyChangedSignal(
                "IsLoaded"
            ),
            function()
                pcall(function()
                    if imageLabel.IsLoaded then
                        imageLabel.Visible =
                            true

                        fallback.Visible =
                            false
                    else
                        imageLabel.Visible =
                            false

                        fallback.Visible =
                            true
                    end
                end)
            end
        )
    end

    return holder,
        imageLabel,
        fallback
end

local function AnimateButton(
    button,
    baseColor,
    hoverColor
)
    if not button then
        return
    end

    local scale

    pcall(function()
        scale =
            Instance.new(
                "UIScale"
            )

        scale.Scale = 1
        scale.Parent = button
    end)

    Connect(
        button.MouseEnter,
        function()
            CreateTween(
                button,
                0.12,
                {
                    BackgroundColor3 =
                        hoverColor or
                        baseColor
                }
            )

            if scale then
                CreateTween(
                    scale,
                    0.12,
                    {
                        Scale = 1.02
                    }
                )
            end
        end
    )

    Connect(
        button.MouseLeave,
        function()
            CreateTween(
                button,
                0.12,
                {
                    BackgroundColor3 =
                        baseColor
                }
            )

            if scale then
                CreateTween(
                    scale,
                    0.12,
                    {
                        Scale = 1
                    }
                )
            end
        end
    )

    Connect(
        button.MouseButton1Down,
        function()
            if scale then
                CreateTween(
                    scale,
                    0.08,
                    {
                        Scale = 0.97
                    }
                )
            end
        end
    )

    Connect(
        button.MouseButton1Up,
        function()
            if scale then
                CreateTween(
                    scale,
                    0.1,
                    {
                        Scale = 1
                    }
                )
            end
        end
    )
end

