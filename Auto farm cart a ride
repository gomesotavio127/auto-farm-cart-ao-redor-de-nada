local GetSeatedCartFromHumanoid
local SyncAntiSeatedCart

local function findCartFromSeat(
    humanoid,
    seatPart
)
    if not humanoid then
        return nil
    end

    local resolvedSeat =
        seatPart

    if not resolvedSeat then
        pcall(function()
            resolvedSeat =
                humanoid.SeatPart
        end)
    end

    if not resolvedSeat then
        return nil
    end

    if not resolvedSeat:IsA(
        "Seat"
    )
        and not resolvedSeat:IsA(
            "VehicleSeat"
        ) then
        return nil
    end

    local occupant

    pcall(function()
        occupant =
            resolvedSeat.Occupant
    end)

    if occupant ~=
        humanoid then
        return nil
    end

    local cart

    pcall(function()
        cart =
            resolvedSeat:
            FindFirstAncestorOfClass(
                "Model"
            )
    end)

    if cart
        and cart.Parent
        and cart:IsDescendantOf(
            Workspace
        ) then
        return cart
    end

    return nil
end

GetSeatedCartFromHumanoid =
findCartFromSeat

local function LogAntiDescarrilhadorState(
    humanoid,
    seatPart
)
    if not humanoid then
        return
    end

    local cart =
        GetSeatedCartFromHumanoid(
            humanoid,
            seatPart
        )

    local seated =
        cart ~= nil

    if seated then
        if State.AntiDescarrilhadorLastLoggedSeated ~=
            true
            or State.AntiDescarrilhadorLastLoggedCart ~=
            cart then

            print(
                "[AntiDescarrilhador] Jogador sentado: true | Carrinho: " ..
                tostring(
                    cart.Name
                )
            )
        end
    elseif State.AntiDescarrilhadorLastLoggedSeated ~=
        false then

        print(
            "[AntiDescarrilhador] Jogador sentado: false"
        )
    end

    State.AntiDescarrilhadorLastLoggedSeated =
        seated

    State.AntiDescarrilhadorLastLoggedCart =
        seated and cart or nil

    return
        seated,
        cart
end

SyncAntiSeatedCart =
function(
    humanoid,
    seatPart
)
    if not State.AntiDescarrilhadorEnabled then
        return false
    end

    local cart =
        GetSeatedCartFromHumanoid(
            humanoid,
            seatPart
        )

    if not cart then
        CleanupAntiCurrentCart()
        return false
    end

    if State.AntiDescarrilhadorCurrentCart ~=
        cart then

        CleanupAntiCurrentCart()

        State.AntiDescarrilhadorCurrentCart =
            cart
    end

    local referencePart =
        SafeGetPrimaryPart(
            cart
        )

    if referencePart
        and referencePart.Parent then

        State.AntiDescarrilhadorWheels =
            GetAntiDescarrilhadorWheels(
                cart,
                referencePart
            )

        State.AntiDescarrilhadorLastScan =
            os.clock()

        ApplyAntiSpeedControllers(
            cart
        )

        ApplyAntiWheelForces()
    end

    return true
end

local function BindAntiHumanoid(
    humanoid
)
    if State.AntiDescarrilhadorSeatedConnection then
        DisconnectConnection(
            State.AntiDescarrilhadorSeatedConnection
        )
    end

    if State.AntiDescarrilhadorSeatPropertyConnection then
        DisconnectConnection(
            State.AntiDescarrilhadorSeatPropertyConnection
        )
    end

    State.AntiDescarrilhadorHumanoid =
        humanoid

    State.AntiDescarrilhadorLastLoggedSeated =
        nil

    State.AntiDescarrilhadorLastLoggedCart =
        nil

    if not humanoid then
        print(
            "[AntiDescarrilhador] Jogador sentado: false"
        )

        State.AntiDescarrilhadorLastLoggedSeated =
            false

        return
    end

    State.AntiDescarrilhadorSeatedConnection =
        Connect(
            humanoid.Seated,
            function(active, seatPart)
                local seated,
                    cart =
                    LogAntiDescarrilhadorState(
                        humanoid,
                        seatPart
                    )

                if not State.AntiDescarrilhadorEnabled then
                    return
                end

                if not active
                    or not seated
                    or not cart then

                    CleanupAntiCurrentCart()
                    UpdateAntiDescarrilhadorGui()

                    return
                end

                SyncAntiSeatedCart(
                    humanoid,
                    seatPart
                )
            end
        )

    State.AntiDescarrilhadorSeatPropertyConnection =
        Connect(
            humanoid:GetPropertyChangedSignal(
                "SeatPart"
            ),
            function()
                local seated,
                    cart =
                    LogAntiDescarrilhadorState(
                        humanoid,
                        nil
                    )

                if not seated
                    or not cart then

                    CleanupAntiCurrentCart()

                    return
                end

                if State.AntiDescarrilhadorEnabled then
                    SyncAntiSeatedCart(
                        humanoid,
                        humanoid.SeatPart
                    )
                end
            end
        )

    LogAntiDescarrilhadorState(
        humanoid,
        humanoid.SeatPart
    )
end

