local function StartFarm()
    if GuiFechada
        or Running then
        return
    end

    Running =
        true

    State.Running =
        true

    CyclesCompleted =
        0

    State.CyclesCompleted =
        0

    RunStartedAt =
        os.clock()

    State.RunStartedAt =
        RunStartedAt

    ActiveCart =
        nil

    State.ActiveCart =
        nil

    CurrentStage =
        nil

    CurrentStageSource =
        nil

    State.CurrentStage =
        nil

    State.CurrentStageSource =
        nil

    SetAutoFarmToggleVisual(
        true
    )

    if State.FarmThread then
        return
    end

    State.FarmThread =
        task.spawn(
            function()
                while Running
                    and not GuiFechada do

                    local success =
                        false

                    pcall(function()
                        success =
                            ExecuteCycle()
                    end)

                    if success then
                        CyclesCompleted +=
                            1

                        State.CyclesCompleted =
                            CyclesCompleted

                        task.wait(
                            Config.Farm.PostCycleDelay
                        )
                    else
                        if Running then
                            ActiveCart =
                                nil

                            State.ActiveCart =
                                nil

                            task.wait(
                                0.5
                            )
                        end
                    end
                end

                State.FarmThread =
                    nil
            end
        )
end

