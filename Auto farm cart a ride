local function GetAntiDescarrilhadorWheels(
    cart,
    referencePart
)
    if not cart
        or not cart.Parent then
        return {}
    end

    local keywords = {
        "wheel",
        "roue",
        "tire",
        "axle",
        "roda",
        "tyre",
        "pneu"
    }

    local preferred = {}
    local allParts = {}
    local used = {}

    local ok, descendants =
        pcall(function()
            return cart:GetDescendants()
        end)

    if not ok
        or not descendants then
        return {}
    end

    for _, object in ipairs(
        descendants
    ) do
        local isPart = false

        pcall(function()
            isPart =
                object:IsA(
                    "BasePart"
                )
        end)

        if isPart then
            table.insert(
                allParts,
                object
            )

            local name =
                Normalize(
                    object.Name
                )

            local matched =
                false

            for _, keyword in ipairs(
                keywords
            ) do
                if string.find(
                    name,
                    keyword,
                    1,
                    true
                ) then
                    matched =
                        true

                    break
                end
            end

            if matched
                and object ~=
                    referencePart then
                used[object] =
                    true

                table.insert(
                    preferred,
                    object
                )
            end
        end
    end

    table.sort(
        preferred,
        function(a, b)
            local ay = 0
            local by = 0

            pcall(function()
                ay =
                    a.Position.Y
            end)

            pcall(function()
                by =
                    b.Position.Y
            end)

            return ay <
                by
        end
    )

    local wheels = {}

    for _, part in ipairs(
        preferred
    ) do
        if part
            and part.Parent
            and #wheels < 8 then
            table.insert(
                wheels,
                part
            )
        end
    end

    if #wheels >= 2 then
        return wheels
    end

    table.sort(
        allParts,
        function(a, b)
            local ay = 0
            local by = 0

            pcall(function()
                ay =
                    a.Position.Y
            end)

            pcall(function()
                by =
                    b.Position.Y
            end)

            return ay <
                by
        end
    )

    table.clear(wheels)

    for _, part in ipairs(
        allParts
    ) do
        if part ~=
            referencePart
            and #wheels <
                Config.AntiDescarrilhador.WHEEL_FALLBACK_COUNT then
            table.insert(
                wheels,
                part
            )
        end
    end

    return wheels
end

