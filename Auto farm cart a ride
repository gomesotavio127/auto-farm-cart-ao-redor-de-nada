local function ShowPage(
    name,
    instant
)
    local target =
        Pages[name]

    if not target then
        return
    end

    local oldPage =
        State.CurrentPage

    for pageName,
        page in pairs(
            Pages
        ) do
        if pageName ==
            name then
            if instant then
                pcall(function()
                    page.Visible =
                        true

                    page.Position =
                        UDim2.fromScale(
                            0,
                            0
                        )

                    page.GroupTransparency =
                        0
                end)
            else
                pcall(function()
                    page.Visible =
                        true

                    page.Position =
                        UDim2.new(
                            0.025,
                            0,
                            0,
                            0
                        )

                    page.GroupTransparency =
                        1
                end)

                CreateTween(
                    page,
                    0.15,
                    {
                        Position =
                            UDim2.fromScale(
                                0,
                                0
                            ),
                        GroupTransparency =
                            0
                    }
                )
            end
        else
            pcall(function()
                page.Visible =
                    false
            end)
        end
    end

    State.CurrentPage =
        name

    for pageName,
        data in pairs(
            NavigationButtons
        ) do
        pcall(function()
            data.Accent.Visible =
                pageName == name

            data.Label.TextColor3 =
                pageName == name
                and COR_TEXTO
                or COR_TEXTO_SECUNDARIO
        end)
    end

    if UI.HeaderSubtitle then
        local subtitles = {
            Home =
                "Painel inicial do Cart Ride Hub",
            Principal =
                "Funções principais e monitoramento",
            Ferramentas =
                "Ferramentas auxiliares do hub",
            Troll =
                "Categoria em desenvolvimento"
        }

        UI.HeaderSubtitle.Text =
            subtitles[name] or ""
    end
end

