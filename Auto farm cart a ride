local function Normalize(value)
    local result = ""

    pcall(function()
        result = string.lower(
            tostring(value or "")
        )
    end)

    return result
end

local function GetStageFromText(value)
    local text = Normalize(value)

    if text == "" then
        return nil
    end

    if string.find(
        text,
        STARTING,
        1,
        true
    ) then
        return STARTING
    end

    if string.find(
        text,
        SUFFERING,
        1,
        true
    ) then
        return SUFFERING
    end

    if string.find(
        text,
        SUFFERED,
        1,
        true
    ) then
        return SUFFERED
    end

    return nil
end

local PlayerName = Normalize(
    Player and Player.Name
)

local PlayerDisplayName = Normalize(
    Player and Player.DisplayName
)

local function ContainsPlayer(value)
    local text = Normalize(value)

    if text == "" then
        return false
    end

    if PlayerName ~= ""
        and string.find(
            text,
            PlayerName,
            1,
            true
        ) then
        return true
    end

    if PlayerDisplayName ~= ""
        and string.find(
            text,
            PlayerDisplayName,
            1,
            true
        ) then
        return true
    end

    return false
end

local function GetObjectText(object)
    if not object then
        return nil
    end

    local text

    pcall(function()
        if object:IsA("TextLabel")
            or object:IsA("TextButton")
            or object:IsA("TextBox") then
            text = object.Text
        elseif object:IsA("StringValue") then
            text = object.Value
        end
    end)

    return text
end

local function AttributesContainPlayer(object)
    if not object then
        return false
    end

    local ok, attributes = pcall(function()
        return object:GetAttributes()
    end)

    if not ok
        or not attributes then
        return false
    end

    for _, value in pairs(attributes) do
        if type(value) == "string"
            and ContainsPlayer(value) then
            return true
        end
    end

    return false
end

local function FindStageInContainer(
    container,
    requirePlayer
)
    if not container then
        return nil, nil
    end

    local ok, descendants = pcall(function()
        return container:GetDescendants()
    end)

    if not ok
        or not descendants then
        return nil, nil
    end

    for _, object in ipairs(
        descendants
    ) do
        local name = ""
        local text = GetObjectText(object)

        pcall(function()
            name = Normalize(
                object.Name
            )
        end)

        local stage = GetStageFromText(
            text or name
        )

        if stage then
            if not requirePlayer then
                return stage,
                    "Objeto: " ..
                    tostring(object.Name)
            end

            if ContainsPlayer(name)
                or ContainsPlayer(text)
                or AttributesContainPlayer(object) then
                return stage,
                    "Objeto: " ..
                    tostring(object.Name)
            end
        end
    end

    return nil, nil
end

local function DetectStage()
    local stage
    local source

    pcall(function()
        if Player and Player.Team then
            local teamStage =
                GetStageFromText(
                    Player.Team.Name
                )

            if teamStage then
                stage = teamStage
                source =
                    "Team: " ..
                    tostring(
                        Player.Team.Name
                    )
            end
        end
    end)

    if stage then
        return stage, source
    end

    local playerGui

    pcall(function()
        playerGui =
            Player and
            Player:FindFirstChildOfClass(
                "PlayerGui"
            )
    end)

    if playerGui then
        stage, source =
            FindStageInContainer(
                playerGui,
                false
            )

        if stage then
            return stage, source
        end
    end

    stage, source =
        FindStageInContainer(
            Workspace,
            true
        )

    if stage then
        return stage, source
    end

    local replicatedStorage

    pcall(function()
        replicatedStorage =
            game:GetService(
                "ReplicatedStorage"
            )
    end)

    if replicatedStorage then
        stage, source =
            FindStageInContainer(
                replicatedStorage,
                true
            )

        if stage then
            return stage, source
        end
    end

    return nil, nil
end

local function IsUnavailablePart(part)
    if not part then
        return false
    end

    local color

    local ok = pcall(function()
        color = part.Color
    end)

    if not ok
        or not color then
        return false
    end

    local brightness =
        (
            color.R +
            color.G +
            color.B
        ) / 3

    local black =
        brightness <= 0.15

    local red =
        color.R >= 0.18
        and color.R >
            color.G * 1.35
        and color.R >
            color.B * 1.35

    return black or red
end

local function FindInteractionNear(
    position,
    radius
)
    if not position then
        return nil
    end

    local best
    local bestDistance = math.huge

    local ok, descendants = pcall(function()
        return Workspace:GetDescendants()
    end)

    if not ok
        or not descendants then
        return nil
    end

    for _, object in ipairs(
        descendants
    ) do
        local valid = false

        pcall(function()
            valid =
                object:IsA("ClickDetector")
                or object:IsA("ProximityPrompt")
        end)

        if valid then
            local parent

            pcall(function()
                parent = object.Parent
            end)

            if parent then
                local part = false

                pcall(function()
                    part = parent:IsA("BasePart")
                end)

                if part
                    and not IsUnavailablePart(parent) then
                    local distance

                    pcall(function()
                        distance =
                            (
                                parent.Position -
                                position
                            ).Magnitude
                    end)

                    if distance
                        and distance <= radius
                        and distance < bestDistance then
                        best = object
                        bestDistance = distance
                    end
                end
            end
        end
    end

    return best
end

local function FireInteraction(interaction)
    if not interaction then
        return false
    end

    local kind

    pcall(function()
        if interaction:IsA(
            "ClickDetector"
        ) then
            kind = "click"
        elseif interaction:IsA(
            "ProximityPrompt"
        ) then
            kind = "prompt"
        end
    end)

    if kind == "click" then
        if type(
            fireclickdetector
        ) ~= "function" then
            return false
        end

        return pcall(function()
            fireclickdetector(
                interaction
            )
        end)
    end

    if kind == "prompt" then
        if type(
            fireproximityprompt
        ) ~= "function" then
            return false
        end

        return pcall(function()
            fireproximityprompt(
                interaction
            )
        end)
    end

    return false
end

local function GetSpawnList(stage)
    local list = {}

    for _, position in ipairs(
        NORMAL_SPAWNS
    ) do
        table.insert(
            list,
            position
        )
    end

    if stage == SUFFERING then
        for _, position in ipairs(
            SUFFERING_EXTRA_SPAWNS
        ) do
            table.insert(
                list,
                position
            )
        end
    end

    return list
end

local function FindAvailableSpawn(stage)
    local root = SafeGetRoot()

    if not root then
        return nil, nil, nil
    end

    local candidates = {}

    for index, position in ipairs(
        GetSpawnList(stage)
    ) do
        local interaction =
            FindInteractionNear(
                position,
                Config.Farm.SpawnRadius
            )

        if interaction then
            local distance

            pcall(function()
                distance =
                    (
                        root.Position -
                        position
                    ).Magnitude
            end)

            if distance then
                table.insert(
                    candidates,
                    {
                        index = index,
                        position = position,
                        interaction = interaction,
                        distance = distance
                    }
                )
            end
        end
    end

    table.sort(
        candidates,
        function(a, b)
            return a.distance <
                b.distance
        end
    )

    local selected =
        candidates[1]

    if not selected then
        return nil, nil, nil
    end

    return
        selected.position,
        selected.interaction,
        selected
end

local function SpawnCart(stage)
    local root = SafeGetRoot()

    if not root then
        return false
    end

    local position,
        interaction,
        data =
        FindAvailableSpawn(stage)

    if not position
        or not interaction then
        return false
    end

    pcall(function()
        root.CFrame =
            CFrame.new(
                position +
                Vector3.new(
                    0,
                    Config.Farm.SpawnTeleportOffset,
                    0
                )
            )
    end)

    task.wait(
        Config.Farm.SpawnConfirmDelay
    )

    local latest =
        FindInteractionNear(
            position,
            Config.Farm.SpawnRadius
        )

    if not latest then
        return false
    end

    if not FireInteraction(
        latest
    ) then
        return false
    end

    State.LastSpawnIndex =
        data and data.index or nil

    task.wait(
        Config.Farm.SpawnSettleDelay
    )

    return true
end

local function FindCart()
    local humanoid =
        SafeGetHumanoid()

    if humanoid
        and humanoid.SeatPart then
        local cart

        pcall(function()
            cart =
                humanoid.SeatPart:
                FindFirstAncestorOfClass(
                    "Model"
                )
        end)

        if cart then
            return cart
        end
    end

    local root = SafeGetRoot()

    if not root then
        return nil
    end

    local best
    local bestDistance = math.huge

    local ok, descendants =
        pcall(function()
            return Workspace:GetDescendants()
        end)

    if not ok
        or not descendants then
        return nil
    end

    for _, object in ipairs(
        descendants
    ) do
        local isSeat = false

        pcall(function()
            isSeat =
                object:IsA(
                    "VehicleSeat"
                )
                or object:IsA("Seat")
        end)

        if isSeat then
            local distance

            pcall(function()
                distance =
                    (
                        object.Position -
                        root.Position
                    ).Magnitude
            end)

            if distance
                and distance <=
                    Config.Farm.CartSearchRadius
                and distance <
                    bestDistance then
                local model

                pcall(function()
                    model =
                        object:
                        FindFirstAncestorOfClass(
                            "Model"
                        )
                end)

                if model then
                    best = model
                    bestDistance = distance
                end
            end
        end
    end

    return best
end

local function FindCartWithRetry()
    local started =
        os.clock()

    while Running
        and os.clock() -
            started <
            Config.Farm.CartFindTimeout do

        local cart = FindCart()

        if cart then
            return cart
        end

        task.wait(
            Config.Farm.CartSearchInterval
        )
    end

    return nil
end

local function SitInCart(cart)
    if not cart
        or not cart.Parent then
        return false
    end

    local humanoid =
        SafeGetHumanoid()

    if not humanoid then
        return false
    end

    local seat

    pcall(function()
        seat =
            cart:
            FindFirstChildWhichIsA(
                "VehicleSeat",
                true
            )
    end)

    if not seat then
        pcall(function()
            seat =
                cart:
                FindFirstChildWhichIsA(
                    "Seat",
                    true
                )
        end)
    end

    if not seat then
        return false
    end

    local ok = pcall(function()
        seat:Sit(humanoid)
    end)

    if not ok then
        return false
    end

    task.wait(0.7)

    local seated = false

    pcall(function()
        seated =
            humanoid.SeatPart ==
                seat
            or humanoid.Sit
    end)

    return seated
end

local function MoveCart(
    cart,
    position,
    lookAt
)
    if not cart
        or not cart.Parent
        or not position then
        return false
    end

    local target

    pcall(function()
        if lookAt then
            target =
                CFrame.lookAt(
                    position,
                    lookAt,
                    Vector3.new(
                        0,
                        1,
                        0
                    )
                )
        else
            target =
                CFrame.new(
                    position
                )
        end
    end)

    if not target then
        return false
    end

    local moved = false

    pcall(function()
        cart:PivotTo(
            target
        )
        moved = true
    end)

    if not moved then
        local primary

        pcall(function()
            primary =
                cart.PrimaryPart
        end)

        if primary then
            pcall(function()
                primary.CFrame =
                    target
                moved = true
            end)
        end
    end

    return moved
end

local function WaitAtDoor()
    local started =
        os.clock()

    while Running
        and os.clock() -
            started <
            Config.Farm.DoorWait do
        task.wait(0.1)
    end

    return Running
end

local function PressGreenButton()
    for _ = 1,
        Config.Farm.GreenRetries do

        local root =
            SafeGetRoot()

        if root then
            pcall(function()
                root.CFrame =
                    CFrame.new(
                        PONTO_3 +
                        Vector3.new(
                            0,
                            2,
                            0
                        )
                    )
            end)
        end

        task.wait(0.15)

        local interaction =
            FindInteractionNear(
                PONTO_3,
                Config.Farm.GreenRadius
            )

        if interaction
            and FireInteraction(
                interaction
            ) then
            return true
        end

        task.wait(
            Config.Farm.GreenRetryWait
        )
    end

    return false
end

local function WaitForStage(
    targetA,
    targetB
)
    local started =
        os.clock()

    while Running do
        local stage, source =
            DetectStage()

        if stage then
            CurrentStage =
                stage
            CurrentStageSource =
                source

            State.CurrentStage =
                stage
            State.CurrentStageSource =
                source

            if stage == targetA
                or stage == targetB then
                return stage
            end
        end

        if os.clock() -
            started >= 18 then
            return CurrentStage
        end

        task.wait(
            Config.Farm.StagePollInterval
        )
    end

    return nil
end

local function ExecuteStarting()
    if not SpawnCart(
        STARTING
    ) then
        return false
    end

    local cart =
        FindCartWithRetry()

    if not cart then
        return false
    end

    ActiveCart = cart
    State.ActiveCart = cart

    if not SitInCart(cart) then
        return false
    end

    MoveCart(
        cart,
        PONTO_1
    )

    if not WaitAtDoor() then
        return false
    end

    MoveCart(
        cart,
        FRENTE_PONTO_1
    )

    local stage =
        WaitForStage(
            SUFFERING,
            SUFFERED
        )

    if stage == SUFFERING then
        MoveCart(
            cart,
            PONTO_2
        )

        if not WaitAtDoor() then
            return false
        end

        MoveCart(
            cart,
            FRENTE_PONTO_2
        )

        MoveCart(
            cart,
            PONTO_3
        )

        stage =
            WaitForStage(
                SUFFERED,
                SUFFERED
            )
    end

    if stage == SUFFERED then
        return PressGreenButton()
    end

    return false
end

local function ExecuteSuffering()
    if not SpawnCart(
        SUFFERING
    ) then
        return false
    end

    local cart =
        FindCartWithRetry()

    if not cart then
        return false
    end

    ActiveCart = cart
    State.ActiveCart = cart

    if not SitInCart(cart) then
        return false
    end

    MoveCart(
        cart,
        PONTO_2
    )

    if not WaitAtDoor() then
        return false
    end

    MoveCart(
        cart,
        FRENTE_PONTO_2
    )

    MoveCart(
        cart,
        PONTO_3
    )

    local stage =
        WaitForStage(
            SUFFERED,
            SUFFERED
        )

    if stage == SUFFERED then
        return PressGreenButton()
    end

    return false
end

local function ExecuteSuffered()
    local cart = ActiveCart

    if not cart
        or not cart.Parent then
        cart =
            FindCartWithRetry()

        if cart then
            ActiveCart = cart
            State.ActiveCart =
                cart
        end
    end

    if cart
        and cart.Parent then
        MoveCart(
            cart,
            PONTO_3
        )

        task.wait(
            Config.Farm.Point3SettleDelay
        )
    end

    return PressGreenButton()
end

local function ExecuteCycle()
    local stage, source =
        DetectStage()

    CurrentStage =
        stage

    CurrentStageSource =
        source

    State.CurrentStage =
        stage

    State.CurrentStageSource =
        source

    if stage == SUFFERED then
        return ExecuteSuffered()
    end

    ActiveCart = nil
    State.ActiveCart = nil

    if stage == STARTING then
        return ExecuteStarting()
    end

    if stage == SUFFERING then
        return ExecuteSuffering()
    end

    return false
end

