        end)

        if isTextObject then
            local font

            pcall(function()
                font =
                    tostring(
                        object.Font
                    )
            end)

            if not font
                or not string.find(
                    font,
                    "Gotham",
                    1,
                    true
                ) then
                pcall(function()
                    object.Font =
                        Enum.Font.Gotham
                end)
            end
        end
    end
end

