local function GetAntiDescarrilhadorWheels(
    cart,
    referencePart
)
    if not cart
        or not cart.Parent
        or not referencePart then
        return {}
    end

    local descendants

    pcall(function()
        descendants =
            cart:GetDescendants()
    end)

    if not descendants then
        return {}
    end

    local keywords = {
        "wheel",
        "roue",
        "tire",
        "axle",
        "roda",
        "tyre",
        "pneu"
    }

    local wheels = {}
    local used = {}

    for _, object in ipairs(
        descendants
    ) do
        if IsAntiBasePart(
            object
        )
            and object ~=
            referencePart then

            local name =
                NormalizeAntiName(
                    object.Name
                )

            local matched =
                false

            for _, keyword in ipairs(
                keywords
            ) do
                if string.find(
                    name,
                    keyword,
                    1,
                    true
                ) then
                    matched =
                        true

                    break
                end
            end

            if matched
                and not used[
                    object
                ] then

                used[
                    object
                ] =
                    true

                table.insert(
                    wheels,
                    object
                )
            end
        end
    end

    if #wheels > 0 then
        table.sort(
            wheels,
            function(a, b)
                return a.Position.Y <
                    b.Position.Y
            end
        )

        while #wheels >
            Config.AntiDescarrilhador.MAX_WHEELS do

            table.remove(
                wheels
            )
        end

        return wheels
    end

    local lowestParts =
        {}

    for _, object in ipairs(
        descendants
    ) do
        if IsAntiBasePart(
            object
        )
            and object ~=
            referencePart then

            table.insert(
                lowestParts,
                object
            )
        end
    end

    table.sort(
        lowestParts,
        function(a, b)
            return a.Position.Y <
                b.Position.Y
        end
    )

    local fallbackCount =
        math.min(
            Config.AntiDescarrilhador.WHEEL_FALLBACK_COUNT,
            #lowestParts
        )

    for index = 1,
        fallbackCount do

        table.insert(
            wheels,
            lowestParts[
                index
            ]
        )
    end

    return wheels
end

local function GetAntiWheelsText()
    local names =
        {}

    for _, wheel in ipairs(
        State.AntiDescarrilhadorWheels
    ) do
        if wheel
            and wheel.Parent then

            table.insert(
                names,
                tostring(
                    wheel.Name
                )
            )
        end
    end

    if #names ==
        0 then
        return
            "0 | —"
    end

    return
        tostring(
            #names
        ) ..
        " | " ..
        table.concat(
            names,
            ", "
        )
end

local function FindAntiSpeedControllers(
    cart
)
    local controllers =
        {}

    if not cart
        or not cart.Parent then
        return controllers
    end

    local descendants

    pcall(function()
        descendants =
            cart:GetDescendants()
    end)

    if not descendants then
        return controllers
    end

    for _, object in ipairs(
        descendants
    ) do

        if object:IsA(
            "LinearVelocity"
        ) then
            table.insert(
                controllers,
                object
            )

        elseif object:IsA(
            "VehicleSeat"
        ) then
            table.insert(
                controllers,
                {
                    ClassName =
                        "VehicleSeat",
                    Instance =
                        object
                }
            )

        elseif object:IsA(
            "NumberValue"
        ) then

            local name =
                NormalizeAntiName(
                    object.Name
                )

            if name ==
                "maxspeed"
                or name ==
                "topspeed" then

                table.insert(
                    controllers,
                    object
                )
            end
        end
    end

    for _, attributeName in ipairs(
        {
            "MaxSpeed",
            "TopSpeed"
        }
    ) do

        local value
        local exists =
            false

        pcall(function()
            value =
                cart:GetAttribute(
                    attributeName
                )

            exists =
                value ~= nil
        end)

        if exists then
            table.insert(
                controllers,
                {
                    ClassName =
                        "Attribute",
                    Instance =
                        cart,
                    Attribute =
                        attributeName
                }
            )
        end
    end

    return controllers
end

local function ApplyAntiSpeedControllers(
    cart
)
    local controllers =
        FindAntiSpeedControllers(
            cart
        )

    table.clear(
        State.AntiDescarrilhadorSpeedControllers
    )

    State.AntiDescarrilhadorSpeedApplied =
        nil

    local targetSpeed =
        Config.AntiDescarrilhador.TARGET_SPEED

    for _, controller in ipairs(
        controllers
    ) do

        local className

        pcall(function()
            className =
                controller.ClassName
        end)

        if className ==
            "LinearVelocity" then

            if not State.AntiDescarrilhadorOriginalSpeedValues[
                controller
            ] then

                State.AntiDescarrilhadorOriginalSpeedValues[
                    controller
                ] =
                    {
                        ClassName =
                            "LinearVelocity",

                        ForceLimitsEnabled =
                            controller.ForceLimitsEnabled,

                        VelocityConstraintMode =
                            controller.VelocityConstraintMode,

                        VectorVelocity =
                            controller.VectorVelocity,

                        LineVelocity =
                            controller.LineVelocity,

                        PlaneVelocity =
                            controller.PlaneVelocity
                    }
            end

            pcall(function()
                controller.ForceLimitsEnabled =
                    false
            end)

            local mode

            pcall(function()
                mode =
                    controller.VelocityConstraintMode
            end)

            if mode ==
                Enum.VelocityConstraintMode.Line then

                pcall(function()
                    controller.LineVelocity =
                        targetSpeed
                end)

            elseif mode ==
                Enum.VelocityConstraintMode.Plane then

                pcall(function()
                    controller.PlaneVelocity =
                        Vector2.new(
                            targetSpeed,
                            0
                        )
                end)

            else

                local direction =
                    Vector3.new(
                        0,
                        0,
                        -1
                    )

                pcall(function()
                    local vector =
                        controller.VectorVelocity

                    if vector.Magnitude >
                        0.1 then

                        direction =
                            vector.Unit
                    end
                end)

                pcall(function()
                    controller.VectorVelocity =
                        direction *
                        targetSpeed
                end)
            end

            table.insert(
                State.AntiDescarrilhadorSpeedControllers,
                controller
            )

            State.AntiDescarrilhadorSpeedApplied =
                targetSpeed

        elseif className ==
            "VehicleSeat" then

            local seat =
                controller.Instance

            if seat then

                if not State.AntiDescarrilhadorOriginalSpeedValues[
                    controller
                ] then

                    State.AntiDescarrilhadorOriginalSpeedValues[
                        controller
                    ] =
                        {
                            ClassName =
                                "VehicleSeat",
                            MaxSpeed =
                                seat.MaxSpeed
                        }
                end

                pcall(function()
                    seat.MaxSpeed =
                        targetSpeed
                end)

                table.insert(
                    State.AntiDescarrilhadorSpeedControllers,
                    controller
                )

                State.AntiDescarrilhadorSpeedApplied =
                    targetSpeed
            end

        elseif className ==
            "NumberValue" then

            if not State.AntiDescarrilhadorOriginalSpeedValues[
                controller
            ] then

                State.AntiDescarrilhadorOriginalSpeedValues[
                    controller
                ] =
                    {
                        ClassName =
                            "NumberValue",
                        Value =
                            controller.Value
                    }
            end

            pcall(function()
                controller.Value =
                    targetSpeed
            end)

            table.insert(
                State.AntiDescarrilhadorSpeedControllers,
                controller
            )

            State.AntiDescarrilhadorSpeedApplied =
                targetSpeed

        elseif className ==
            "Attribute" then

            local instance =
                controller.Instance

            local attribute =
                controller.Attribute

            if instance
                and attribute then

                if not State.AntiDescarrilhadorOriginalSpeedValues[
                    controller
                ] then

                    State.AntiDescarrilhadorOriginalSpeedValues[
                        controller
                    ] =
                        {
                            ClassName =
                                "Attribute",
                            Attribute =
                                attribute,
                            Value =
                                instance:GetAttribute(
                                    attribute
                                )
                        }
                end

                pcall(function()
                    instance:SetAttribute(
                        attribute,
                        targetSpeed
                    )
                end)

                State.AntiDescarrilhadorSpeedApplied =
                    targetSpeed
            end
        end
    end

    if not State.AntiDescarrilhadorSpeedApplied then
        State.AntiDescarrilhadorSpeedApplied =
            targetSpeed
    end

    return
        State.AntiDescarrilhadorSpeedApplied
end

local function CreateAntiWheelForce(
    wheel
)
    if not wheel
        or not wheel.Parent then
        return nil
    end

    local existing =
        State.AntiDescarrilhadorForces[
            wheel
        ]

    if existing
        and existing.VectorForce
        and existing.VectorForce.Parent ==
        wheel then
        return existing
    end

    if existing then
        DestroyAntiWheelForce(
            wheel
        )
    end

    local attachment =
        Instance.new(
            "Attachment"
        )

    attachment.Name =
        "CarRideAntiWheelForceAttachment"

    attachment.Position =
        Vector3.zero

    attachment.Parent =
        wheel

    local vectorForce =
        Instance.new(
            "VectorForce"
        )

    vectorForce.Name =
        "CarRideAntiWheelDownForce"

    vectorForce.Attachment0 =
        attachment

    vectorForce.RelativeTo =
        Enum.ActuatorRelativeTo.World

    vectorForce.ApplyAtCenterOfMass =
        true

    vectorForce.Force =
        Vector3.zero

    vectorForce.Enabled =
        true

    vectorForce.Parent =
        wheel

    local data = {
        Attachment =
            attachment,

        VectorForce =
            vectorForce
    }

    State.AntiDescarrilhadorForces[
        wheel
    ] =
        data

    return data
end

local function UpdateAntiWheelForce(
    wheel
)
    if not wheel
        or not wheel.Parent then
        return false
    end

    local data =
        CreateAntiWheelForce(
            wheel
        )

    if not data
        or not data.VectorForce then
        return false
    end

    local multiplier =
        Config.AntiDescarrilhador.DOWNFORCE_MULTIPLIER

    local assemblyMass =
        0

    pcall(function()
        assemblyMass =
            wheel.AssemblyMass
    end)

    if assemblyMass <=
        0 then
        return false
    end

    local force =
        assemblyMass *
        multiplier

    pcall(function()
        data.VectorForce.Force =
            Vector3.new(
                0,
                -force,
                0
            )

        data.VectorForce.RelativeTo =
            Enum.ActuatorRelativeTo.World

        data.VectorForce.ApplyAtCenterOfMass =
            true

        data.VectorForce.Enabled =
            true
    end)

    return true
end

local function ApplyAntiWheelForces()
    local active =
        {}

    local count =
        0

    for _, wheel in ipairs(
        State.AntiDescarrilhadorWheels
    ) do

        if wheel
            and wheel.Parent
            and UpdateAntiWheelForce(
                wheel
            ) then

            active[
                wheel
            ] =
                true

            count +=
                1
        end
    end

    for wheel in pairs(
        State.AntiDescarrilhadorForces
    ) do

        if not active[
            wheel
        ] then
            DestroyAntiWheelForce(
                wheel
            )
        end
    end

    State.AntiDescarrilhadorForcesActive =
        count

    return count
end

