local function RestoreAntiCartPhysics()
    ClearAntiWheelForces()

    for controller, data in pairs(
        State.AntiDescarrilhadorOriginalSpeedValues
    ) do
        if controller
            and data then

            pcall(function()
                if data.ClassName ==
                    "LinearVelocity" then

                    controller.ForceLimitsEnabled =
                        data.ForceLimitsEnabled

                    controller.VelocityConstraintMode =
                        data.VelocityConstraintMode

                    controller.VectorVelocity =
                        data.VectorVelocity

                    controller.LineVelocity =
                        data.LineVelocity

                    controller.PlaneVelocity =
                        data.PlaneVelocity

                elseif data.ClassName ==
                    "VehicleSeat" then

                    local seat =
                        controller.Instance

                    if seat then
                        seat.MaxSpeed =
                            data.MaxSpeed
                    end

                elseif data.ClassName ==
                    "NumberValue" then

                    controller.Value =
                        data.Value

                elseif data.ClassName ==
                    "Attribute" then

                    local instance =
                        controller.Instance

                    if instance
                        and controller.Attribute then

                        instance:SetAttribute(
                            controller.Attribute,
                            data.Value
                        )
                    end
                end
            end)
        end
    end

    table.clear(
        State.AntiDescarrilhadorOriginalSpeedValues
    )

    table.clear(
        State.AntiDescarrilhadorSpeedControllers
    )

    State.AntiDescarrilhadorSpeedApplied =
        nil
end

