local function CreateAntiOrientationController(
    referencePart
)
    if not referencePart
        or not referencePart.Parent then
        return
    end

    if State.AntiDescarrilhadorReferencePart ==
        referencePart
        and (
            State.AntiDescarrilhadorAlignOrientation
            or State.AntiDescarrilhadorBodyGyro
        ) then
        return
    end

    CleanupAntiOrientationOnly()

    local attachment

    pcall(function()
        attachment =
            referencePart:FindFirstChild(
                "_StabOrientationAtt"
            )
    end)

    if attachment then
        local valid = false

        pcall(function()
            valid =
                attachment:IsA(
                    "Attachment"
                )
        end)

        if not valid then
            attachment =
                nil
        end
    end

    if not attachment then
        pcall(function()
            attachment =
                Instance.new(
                    "Attachment"
                )

            attachment.Name =
                "_StabOrientationAtt"

            attachment.Parent =
                referencePart
        end)

        if attachment then
            table.insert(
                State.AntiDescarrilhadorCreatedOrientationAttachments,
                attachment
            )
        end
    end

    if not attachment then
        State.AntiDescarrilhadorReferencePart =
            referencePart

        return
    end

    local align
    local alignOk =
        pcall(function()
            align =
                Instance.new(
                    "AlignOrientation"
                )

            align.Name =
                "_StabAlignOrientation"

            align.Mode =
                Enum.OrientationAlignmentMode.OneAttachment

            align.Attachment0 =
                attachment

            align.RigidityEnabled =
                false

            align.MaxTorque =
                math.clamp(
                    Config.AntiDescarrilhador.MAX_TORQUE,
                    5000,
                    12000
                )

            align.Responsiveness =
                math.clamp(
                    Config.AntiDescarrilhador.RESPONSIVENESS,
                    15,
                    30
                )

            align.MaxAngularVelocity =
                35

            align.Parent =
                referencePart
        end)

    if alignOk
        and align then
        State.AntiDescarrilhadorAlignOrientation =
            align

        State.AntiDescarrilhadorUsingAlign =
            true

        State.AntiDescarrilhadorReferencePart =
            referencePart

        return
    end

    SafeDestroy(
        align
    )

    local gyro
    local gyroOk =
        pcall(function()
            gyro =
                Instance.new(
                    "BodyGyro"
                )

            gyro.Name =
                "_StabBodyGyro"

            gyro.MaxTorque =
                Vector3.new(
                    math.clamp(
                        Config.AntiDescarrilhador.MAX_TORQUE,
                        5000,
                        12000
                    ),
                    math.clamp(
                        Config.AntiDescarrilhador.MAX_TORQUE,
                        5000,
                        12000
                    ),
                    math.clamp(
                        Config.AntiDescarrilhador.MAX_TORQUE,
                        5000,
                        12000
                    )
                )

            gyro.P =
                5000

            gyro.D =
                350

            gyro.Parent =
                referencePart
        end)

    if gyroOk
        and gyro then
        State.AntiDescarrilhadorBodyGyro =
            gyro

        State.AntiDescarrilhadorUsingGyro =
            true
    else
        SafeDestroy(
            gyro
        )
    end

    State.AntiDescarrilhadorReferencePart =
        referencePart
end

local function GetPlayerDrivingInput()
    local active = false
    local strong = false

    pcall(function()
        local w =
            UserInputService:IsKeyDown(
                Enum.KeyCode.W
            )

        local a =
            UserInputService:IsKeyDown(
                Enum.KeyCode.A
            )

        local s =
            UserInputService:IsKeyDown(
                Enum.KeyCode.S
            )

        local d =
            UserInputService:IsKeyDown(
                Enum.KeyCode.D
            )

        active =
            w or
            a or
            s or
            d

        strong =
            w
    end)

    pcall(function()
        for _, input in ipairs(
            UserInputService:GetKeysPressed()
        ) do
            if input.KeyCode ==
                Enum.KeyCode.W
                or input.KeyCode ==
                Enum.KeyCode.A
                or input.KeyCode ==
                Enum.KeyCode.S
                or input.KeyCode ==
                Enum.KeyCode.D then
                active =
                    true

                if input.KeyCode ==
                    Enum.KeyCode.W then
                    strong =
                        true
                end
            end
        end
    end)

    return active, strong
end

local function GetSpeedScale(speed)
    local config =
        Config.AntiDescarrilhador

    if speed < 5 then
        return math.clamp(
            config.LOW_SPEED_GAIN,
            0.05,
            0.2
        )
    end

    if speed > 80 then
        return 1.5
    end

    return 1
end

local function GetForwardDirection(
    referencePart,
    velocity
)
    local lookVector

    pcall(function()
        lookVector =
            referencePart.CFrame.LookVector
    end)

    if not lookVector then
        return Vector3.new(
            0,
            0,
            -1
        )
    end

    local flat =
        Vector3.new(
            lookVector.X,
            0,
            lookVector.Z
        )

    if flat.Magnitude <
        0.001 then
        local horizontal =
            Vector3.new(
                velocity.X,
                0,
                velocity.Z
            )

        if horizontal.Magnitude >
            0.5 then
            return horizontal.Unit
        end

        return Vector3.new(
            0,
            0,
            -1
        )
    end

    return flat.Unit
end

local function GetTotalMass(
    referencePart
)
    local mass = 0

    pcall(function()
        mass =
            referencePart.AssemblyMass
    end)

    if type(mass) ~= "number"
        or mass <= 0
        or mass == math.huge then
        return 0
    end

    return mass
end

local function GetGravity()
    local gravity = 196.2

    pcall(function()
        gravity =
            Workspace.Gravity
    end)

    if type(gravity) ~= "number"
        or gravity <= 0
        or gravity == math.huge then
        gravity =
            196.2
    end

    return gravity
end

local function IsFloating(
    referencePart,
    cart
)
    if not referencePart
        or not referencePart.Parent then
        return false
    end

    local raycastResult = nil

    pcall(function()
        local params =
            RaycastParams.new()

        params.FilterType =
            Enum.RaycastFilterType.Exclude

        local exclude = {}

        if cart then
            table.insert(
                exclude,
                cart
            )
        end

        params.FilterDescendantsInstances =
            exclude

        raycastResult =
            Workspace:Raycast(
                referencePart.Position,
                Vector3.new(
                    0,
                    -8,
                    0
                ),
                params
            )
    end)

    return raycastResult == nil
end

local function ApplyAntiDescarrilhador(
    cart
)
    if not State.AntiDescarrilhadorEnabled then
        return false
    end

    if not cart
        or not cart.Parent then
        return false
    end

    local referencePart =
        SafeGetPrimaryPart(
            cart
        )

    if not referencePart
        or not referencePart.Parent then
        return false
    end

    if State.AntiDescarrilhadorCurrentCart ~=
        cart then
        CleanupAntiCurrentCart()

        State.AntiDescarrilhadorCurrentCart =
            cart

        State.AntiDescarrilhadorLastCart =
            cart
    end

    if State.AntiDescarrilhadorReferencePart ~=
        referencePart then
        CreateAntiOrientationController(
            referencePart
        )

        State.AntiDescarrilhadorWheels =
            GetAntiDescarrilhadorWheels(
                cart,
                referencePart
            )
    end

    if #State.AntiDescarrilhadorWheels ==
        0 then
        State.AntiDescarrilhadorWheels =
            GetAntiDescarrilhadorWheels(
                cart,
                referencePart
            )
    end

    for _, wheel in ipairs(
        State.AntiDescarrilhadorWheels
    ) do
        if wheel
            and wheel.Parent then
            local attachment =
                GetOrCreateAntiAttachment(
                    wheel
                )

            if attachment then
                local vf =
                    GetOrCreateAntiVectorForce(
                        attachment
                    )

                if vf then
                    local tracked =
                        false

                    for _, existing in ipairs(
                        State.AntiDescarrilhadorVectorForces
                    ) do
                        if existing ==
                            vf then
                            tracked =
                                true

                            break
                        end
                    end

                    if not tracked then
                        table.insert(
                            State.AntiDescarrilhadorVectorForces,
                            vf
                        )
                    end
                end
            end
        end
    end

    return
        #State.AntiDescarrilhadorVectorForces >
        0
end

local function UpdateAntiOrientation(
    referencePart,
    speed,
    strongW
)
    if not referencePart
        or not referencePart.Parent then
        return
    end

    if speed > 30
        and strongW then
        return
    end

    local upVector
    local forwardVector

    pcall(function()
        upVector =
            referencePart.CFrame.UpVector

        forwardVector =
            referencePart.CFrame.LookVector
    end)

    if not upVector
        or not forwardVector then
        return
    end

    local upDot =
        upVector:Dot(
            Vector3.new(
                0,
                1,
                0
            )
        )

    if upDot >
        0.85 then
        return
    end

    local desiredForward =
        forwardVector

    if desiredForward.Magnitude <
        0.001 then
        desiredForward =
            Vector3.new(
                0,
                0,
                -1
            )
    else
        desiredForward =
            desiredForward.Unit
    end

    local target =
        CFrame.lookAt(
            Vector3.zero,
            desiredForward,
            Vector3.new(
                0,
                1,
                0
            )
        )

    if State.AntiDescarrilhadorUsingAlign
        and State.AntiDescarrilhadorAlignOrientation then
        pcall(function()
            State.AntiDescarrilhadorAlignOrientation.MaxTorque =
                math.clamp(
                    Config.AntiDescarrilhador.MAX_TORQUE,
                    5000,
                    12000
                )

            State.AntiDescarrilhadorAlignOrientation.Responsiveness =
                math.clamp(
                    Config.AntiDescarrilhador.RESPONSIVENESS,
                    15,
                    30
                )

            State.AntiDescarrilhadorAlignOrientation.CFrame =
                target
        end)

        return
    end

    if State.AntiDescarrilhadorUsingGyro
        and State.AntiDescarrilhadorBodyGyro then
        pcall(function()
            State.AntiDescarrilhadorBodyGyro.MaxTorque =
                Vector3.new(
                    math.clamp(
                        Config.AntiDescarrilhador.MAX_TORQUE,
                        5000,
                        12000
                    ),
                    math.clamp(
                        Config.AntiDescarrilhador.MAX_TORQUE,
                        5000,
                        12000
                    ),
                    math.clamp(
                        Config.AntiDescarrilhador.MAX_TORQUE,
                        5000,
                        12000
                    )
                )

            State.AntiDescarrilhadorBodyGyro.D =
                350

            State.AntiDescarrilhadorBodyGyro.P =
                5000

            State.AntiDescarrilhadorBodyGyro.CFrame =
                target
        end)
    end
end

local function ApplyAntiForces(
    dt
)
    if not State.AntiDescarrilhadorEnabled then
        return
    end

    local humanoid =
        SafeGetHumanoid()

    if not humanoid then
        CleanupAntiCurrentCart()
        return
    end

    local seatPart

    pcall(function()
        seatPart =
            humanoid.SeatPart
    end)

    if not seatPart then
        CleanupAntiCurrentCart()
        return
    end

    local seatedCart

    pcall(function()
        seatedCart =
            seatPart:
            FindFirstAncestorOfClass(
                "Model"
            )
    end)

    if not seatedCart
        or not seatedCart.Parent then
        CleanupAntiCurrentCart()
        return
    end

    if State.AntiDescarrilhadorCurrentCart ~=
        seatedCart then
        CleanupAntiCurrentCart()

        State.AntiDescarrilhadorCurrentCart =
            seatedCart

        ApplyAntiDescarrilhador(
            seatedCart
        )
    end

    local cart =
        State.AntiDescarrilhadorCurrentCart

    if not cart
        or not cart.Parent then
        CleanupAntiCurrentCart()
        return
    end

    local referencePart =
        SafeGetPrimaryPart(
            cart
        )

    if not referencePart
        or not referencePart.Parent then
        CleanupAntiCurrentCart()
        return
    end

    if State.AntiDescarrilhadorReferencePart ~=
        referencePart then
        ApplyAntiDescarrilhador(
            cart
        )
    elseif #State.AntiDescarrilhadorVectorForces ==
        0 then
        ApplyAntiDescarrilhador(
            cart
        )
    end

    local velocity =
        Vector3.zero

    local position

    pcall(function()
        velocity =
            referencePart.AssemblyLinearVelocity

        position =
            referencePart.Position
    end)

    local mass =
        GetTotalMass(
            referencePart
        )

    if mass <= 0
        or not velocity then
        return
    end

    local speed =
        velocity.Magnitude

    local activeInput,
        strongW =
        GetPlayerDrivingInput()

    if speed < 1
        and strongW then
        if not State.AntiDescarrilhadorWInputSince then
            State.AntiDescarrilhadorWInputSince =
                os.clock()
        end
    else
        State.AntiDescarrilhadorWInputSince =
            nil
    end

    if speed < 1
        and strongW
        and State.AntiDescarrilhadorWInputSince
        and os.clock() -
            State.AntiDescarrilhadorWInputSince <
            Config.AntiDescarrilhador.START_DELAY then

        for _, vf in ipairs(
            State.AntiDescarrilhadorVectorForces
        ) do
            if vf and vf.Parent then
                pcall(function()
                    vf.Force =
                        Vector3.zero
                end)
            end
        end

        State.AntiDescarrilhadorLastVelocity =
            velocity

        State.AntiDescarrilhadorLastPosition =
            position

        return
    end

    local scale =
        GetSpeedScale(
            speed
        )

    if activeInput then
        scale *=
            math.clamp(
                Config.AntiDescarrilhador.INPUT_GAIN_MULTIPLIER,
                0.25,
                0.75
            )
    end

    local idleLong =
        false

    if speed <
        Config.AntiDescarrilhador.IDLE_SPEED
        then
        if not State.AntiDescarrilhadorIdleSince then
            State.AntiDescarrilhadorIdleSince =
                os.clock()
        end
    else
        State.AntiDescarrilhadorIdleSince =
            nil
    end

    if State.AntiDescarrilhadorIdleSince
        and os.clock() -
            State.AntiDescarrilhadorIdleSince >
            2 then
        idleLong =
            true
    end

    if idleLong then
        scale *=
            0.2
    end

    local forward =
        GetForwardDirection(
            referencePart,
            velocity
        )

    local forwardSpeed =
        velocity:Dot(
            forward
        )

    local lateralVelocity =
        velocity -
        forward *
        forwardSpeed

    local lateralSpeed =
        lateralVelocity.Magnitude

    local velocityDirection =
        Vector3.zero

    local angleDegrees = 0

    if speed > 0.1
        and velocity.Magnitude > 0.1 then
        velocityDirection =
            velocity.Unit

        local dot =
            math.clamp(
                velocityDirection:Dot(
                    forward
                ),
                -1,
                1
            )

        angleDegrees =
            math.deg(
                math.acos(dot)
            )
    end

    local currentAcceleration =
        Vector3.zero

    if dt
        and dt > 0
        and dt < 1 then
        currentAcceleration =
            (
                velocity -
                State.AntiDescarrilhadorLastVelocity
            ) / dt
    end

    local accelerationTerm =
        -currentAcceleration

    local kp =
        Config.AntiDescarrilhador.KP *
        scale

    local kd =
        Config.AntiDescarrilhador.KD *
        scale

    local pdAcceleration =
        accelerationTerm *
        kd

    local maxForce =
        math.max(
            Config.AntiDescarrilhador.MAX_FORCE,
            0
        )

    local gravity =
        GetGravity()

    local maxMagnetForce =
        mass *
        gravity *
        math.max(
            Config.AntiDescarrilhador.GRAVITY_MULTIPLIER_LIMIT,
            0
        )

    local magnetForce =
        math.min(
            Config.AntiDescarrilhador.MAGNET_FORCE *
            scale *
            mass,
            maxMagnetForce
        )

    local magnetDownForce =
        math.min(
            Config.AntiDescarrilhador.MAGNET_FORCE_DOWN *
            scale *
            mass,
            maxMagnetForce
        )

    local verticalVelocity =
        velocity.Y

    local verticalForce =
        0

    local floating =
        IsFloating(
            referencePart,
            cart
        )

    if verticalVelocity <=
        1 then
        if floating then
            verticalForce =
                magnetForce
        else
            verticalForce =
                magnetDownForce
        end
    elseif verticalVelocity < 0 then
        verticalForce =
            magnetDownForce
    else
        verticalForce =
            0
    end

    local totalForce =
        Vector3.new(
            0,
            -verticalForce,
            0
        )

    if lateralSpeed >
        Config.AntiDescarrilhador.LATERAL_SPEED_THRESHOLD
        and angleDegrees >
            Config.AntiDescarrilhador.LATERAL_ANGLE_THRESHOLD
        and forwardSpeed >
            0 then

        local lateralCorrection =
            -lateralVelocity *
            Config.AntiDescarrilhador.LATERAL_DAMPING *
            scale *
            mass

        local lateralMagnitude =
            lateralCorrection.Magnitude

        if lateralMagnitude >
            maxForce then
            lateralCorrection =
                lateralCorrection.Unit *
                maxForce
        end

        totalForce +=
            lateralCorrection
    end

    local motionCorrected =
        velocity

    local forwardError =
        Vector3.zero

    if strongW
        and speed < 30 then
        forwardError =
            Vector3.zero
    else
        local desiredForward =
            math.max(
                0,
                forwardSpeed
            )

        local desiredVelocity =
            forward *
            desiredForward

        forwardError =
            desiredVelocity -
            motionCorrected
    end

    local antiFrontFactor =
        0

    if lateralSpeed <=
        Config.AntiDescarrilhador.LATERAL_SPEED_THRESHOLD
        or angleDegrees <=
        Config.AntiDescarrilhador.LATERAL_ANGLE_THRESHOLD then
        antiFrontFactor =
            0
    end

    if antiFrontFactor >
        0 then
        forwardError =
            forwardError *
            antiFrontFactor
    end

    local longitudinalComponent =
        forwardError *
        kp

    if longitudinalComponent.Magnitude >
        0 then
        local longitudinalDot =
            longitudinalComponent:Dot(
                forward
            )

        if longitudinalDot < 0 then
            longitudinalComponent =
                longitudinalComponent -
                forward *
                longitudinalDot
        end
    end

    pdAcceleration +=
        longitudinalComponent

    local safeAcceleration =
        pdAcceleration

    local maxAcceleration =
        maxForce /
        math.max(
            mass,
            0.001
        )

    if safeAcceleration.Magnitude >
        maxAcceleration then
        safeAcceleration =
            safeAcceleration.Unit *
            maxAcceleration
    end

    local pdForce =
        safeAcceleration *
        mass

    local pdForwardDot =
        pdForce:Dot(
            forward
        )

    if pdForwardDot < 0 then
        pdForce =
            pdForce -
            forward *
            pdForwardDot
    end

    totalForce +=
        pdForce

    if speed < 5 then
        totalForce *=
            math.clamp(
                Config.AntiDescarrilhador.LOW_SPEED_GAIN,
                0.05,
                0.2
            )
    elseif speed > 80 then
        totalForce *=
            1.5
    end

    local forceMagnitude =
        totalForce.Magnitude

    if forceMagnitude >
        maxForce then
        if forceMagnitude > 0 then
            totalForce =
                totalForce.Unit *
                maxForce
        else
            totalForce =
                Vector3.zero
        end
    end

    local totalForceForward =
        totalForce:Dot(
            forward
        )

    if totalForceForward < 0 then
        totalForce =
            totalForce -
            forward *
            totalForceForward
    end

    local wheelCount =
        #State.AntiDescarrilhadorVectorForces

    if wheelCount > 0 then
        local forcePerWheel =
            totalForce /
            wheelCount

        for _, vf in ipairs(
            State.AntiDescarrilhadorVectorForces
        ) do
            if vf
                and vf.Parent then
                pcall(function()
                    vf.Force =
                        forcePerWheel

                    vf.RelativeTo =
                        Enum.ActuatorRelativeTo.World
                end)
            end
        end
    end

    local allowOrientation =
        true

    if speed > 30
        and strongW then
        allowOrientation =
            false
    end

    if allowOrientation then
        UpdateAntiOrientation(
            referencePart,
            speed,
            strongW
        )
    end

    State.AntiDescarrilhadorLastVelocity =
        velocity

    State.AntiDescarrilhadorLastPosition =
        position
end

local function BindAntiHumanoid(
    humanoid
)
    if State.AntiDescarrilhadorSeatedConnection then
        DisconnectConnection(
            State.AntiDescarrilhadorSeatedConnection
        )

        State.AntiDescarrilhadorSeatedConnection =
            nil
    end

    State.AntiDescarrilhadorHumanoid =
        humanoid

    if not humanoid then
        return
    end

    State.AntiDescarrilhadorSeatedConnection =
        Connect(
            humanoid.Seated,
            function(active, seatPart)
                if not State.AntiDescarrilhadorEnabled then
                    return
                end

                if not active
                    or not seatPart then
                    CleanupAntiCurrentCart()
                    return
                end

                local cart

                pcall(function()
                    cart =
                        seatPart:
                        FindFirstAncestorOfClass(
                            "Model"
                        )
                end)

                if cart
                    and cart.Parent then

                    if State.AntiDescarrilhadorCurrentCart ~=
                        cart then
                        CleanupAntiCurrentCart()

                        State.AntiDescarrilhadorCurrentCart =
                            cart
                    end

                    ApplyAntiDescarrilhador(
                        cart
                    )
                else
                    CleanupAntiCurrentCart()
                end
            end
        )
end

local function SetupAntiCharacterWatcher()
    if State.AntiDescarrilhadorCharacterConnection then
        return
    end

    if not Player then
        return
    end

    State.AntiDescarrilhadorCharacterConnection =
        Connect(
            Player.CharacterAdded,
            function(character)
                if not State.AntiDescarrilhadorEnabled then
                    return
                end

                CleanupAntiCurrentCart()

                local humanoid

                pcall(function()
                    humanoid =
                        character:
                        WaitForChild(
                            "Humanoid",
                            5
                        )
                end)

                if humanoid then
                    BindAntiHumanoid(
                        humanoid
                    )
                end
            end
        )
end

local function StartAntiHeartbeat()
    if State.AntiDescarrilhadorHeartbeat then
        return
    end

    if not RunService then
        return
    end

    State.AntiDescarrilhadorHeartbeat =
        Connect(
            RunService.Heartbeat,
            function(dt)
                if not State.AntiDescarrilhadorEnabled then
                    return
                end

                local ok =
                    pcall(function()
                        ApplyAntiForces(dt)
                    end)

                if not ok then
                    pcall(function()
                        CleanupAntiCurrentCart()
                    end)
                end
            end
        )
end

local function EnableAntiDescarrilhador()
    if GuiFechada then
        return false
    end

    State.AntiDescarrilhadorEnabled =
        true

    SetupAntiCharacterWatcher()
    StartAntiHeartbeat()

    local humanoid =
        SafeGetHumanoid()

    if humanoid then
        BindAntiHumanoid(
            humanoid
        )

        local seatPart

        pcall(function()
            seatPart =
                humanoid.SeatPart
        end)

        if seatPart then
            local cart

            pcall(function()
                cart =
                    seatPart:
                    FindFirstAncestorOfClass(
                        "Model"
                    )
            end)

            if cart
                and cart.Parent then
                State.AntiDescarrilhadorCurrentCart =
                    cart

                ApplyAntiDescarrilhador(
                    cart
                )
            end
        end
    end

    SetAntiToggleVisual(
        true
    )

    return true
end

local function DisableAntiDescarrilhador()
    State.AntiDescarrilhadorEnabled =
        false

    CleanupAntiCurrentCart()

    SetAntiToggleVisual(
        false
    )
end

local function CleanupAntiDescarrilhador()
    State.AntiDescarrilhadorEnabled =
        false

    if State.AntiDescarrilhadorHeartbeat then
        DisconnectConnection(
            State.AntiDescarrilhadorHeartbeat
        )

        State.AntiDescarrilhadorHeartbeat =
            nil
    end

    if State.AntiDescarrilhadorCharacterConnection then
        DisconnectConnection(
            State.AntiDescarrilhadorCharacterConnection
        )

        State.AntiDescarrilhadorCharacterConnection =
            nil
    end

    if State.AntiDescarrilhadorSeatedConnection then
        DisconnectConnection(
            State.AntiDescarrilhadorSeatedConnection
        )

        State.AntiDescarrilhadorSeatedConnection =
            nil
    end

    CleanupAntiCurrentCart()

    State.AntiDescarrilhadorHumanoid =
        nil
end

Environment.CarRideAntiDescarrilhadorCleanup =
    CleanupAntiDescarrilhador

Environment.CarRideAntiDescarrilhador = {
    Enable = function()
        return EnableAntiDescarrilhador()
    end,

    Disable = function()
        DisableAntiDescarrilhador()
    end,

    IsEnabled = function()
        return State.AntiDescarrilhadorEnabled
    end,

    GetConfig = function()
        return Config.AntiDescarrilhador
    end
}

local function EnableInstantInteract()
    instantInteractEnabled =
        true

    State.InstantInteractEnabled =
        true

    if not ProximityPromptService then
        instantInteractEnabled =
            false

        State.InstantInteractEnabled =
            false

        SetInstantToggleVisual(
            false
        )

        return false
    end

    if State.InstantInteractConnection then
        DisconnectConnection(
            State.InstantInteractConnection
        )

        State.InstantInteractConnection =
            nil
    end

    State.InstantInteractConnection =
        Connect(
            ProximityPromptService.PromptButtonHoldBegan,
            function(prompt)
                if not instantInteractEnabled then
                    return
                end

                if type(
                    fireproximityprompt
                ) ~= "function" then
                    return
                end

                pcall(function()
                    fireproximityprompt(
                        prompt
                    )
                end)
            end
        )

    SetInstantToggleVisual(
        true
    )

    return
        State.InstantInteractConnection ~=
        nil
end

local function DisableInstantInteract()
    instantInteractEnabled =
        false

    State.InstantInteractEnabled =
        false

    if State.InstantInteractConnection then
        DisconnectConnection(
            State.InstantInteractConnection
        )

        State.InstantInteractConnection =
            nil
    end

    SetInstantToggleVisual(
        false
    )
end

local function StartFarm()
    if GuiFechada
        or Running then
        return
    end

    Running =
        true

    State.Running =
        true

    CyclesCompleted =
        0

    State.CyclesCompleted =
        0

    RunStartedAt =
        os.clock()

    State.RunStartedAt =
        RunStartedAt

    ActiveCart =
        nil

    State.ActiveCart =
        nil

    CurrentStage =
        nil

    CurrentStageSource =
        nil

    State.CurrentStage =
        nil

    State.CurrentStageSource =
        nil

    SetAutoFarmToggleVisual(
        true
    )

    if State.FarmThread then
        return
    end

    State.FarmThread =
        task.spawn(
            function()
                while Running
                    and not GuiFechada do

                    local success =
                        false

                    pcall(function()
                        success =
                            ExecuteCycle()
                    end)

                    if success then
                        CyclesCompleted +=
                            1

                        State.CyclesCompleted =
                            CyclesCompleted

                        task.wait(
                            Config.Farm.PostCycleDelay
                        )
                    else
                        if Running then
                            ActiveCart =
                                nil

                            State.ActiveCart =
                                nil

                            task.wait(
                                0.5
                            )
                        end
                    end
                end

                State.FarmThread =
                    nil
            end
        )
end

local function StopFarm()
    Running =
        false

    State.Running =
        false

    if State.DoorTween then
        pcall(function()
            State.DoorTween:Cancel()
        end)

        State.DoorTween =
            nil
    end

    ActiveCart =
        nil

    State.ActiveCart =
        nil

    CurrentStage =
        nil

    CurrentStageSource =
        nil

    State.CurrentStage =
        nil

    State.CurrentStageSource =
        nil

    SetAutoFarmToggleVisual(
        false
    )
end

local function CloseHub()
    if GuiFechada then
        return
    end

    GuiFechada =
        true

    State.Closed =
        true

    State.Visible =
        false

    StopFarm()
    DisableInstantInteract()
    CleanupAntiDescarrilhador()
    StopAllTweens()

    for _, connection in ipairs(
        State.Connections
    ) do
        DisconnectConnection(
            connection
        )
    end

    table.clear(
        State.Connections
    )

    if State.DragMoveConnection then
        DisconnectConnection(
            State.DragMoveConnection
        )

        State.DragMoveConnection =
            nil
    end

    if State.DragEndConnection then
        DisconnectConnection(
            State.DragEndConnection
        )

        State.DragEndConnection =
            nil
    end

    pcall(function()
        Environment.CarRideAntiDescarrilhadorCleanup =
            nil

        Environment.CarRideAntiDescarrilhador =
            nil

        Environment.CarRideAutoFarm =
            nil

        Environment.CarRideAutoFarmConfig =
            nil
    end)

    pcall(function()
        if UI.ScreenGui then
            UI.ScreenGui:Destroy()
        end
    end)

    UI.ScreenGui =
        nil

    UI.Window =
        nil
end

local function SetupNavigation()
    local pages = {
        Home = "Home",
        Principal = "Principal",
        Ferramentas = "Ferramentas",
        Troll = "Troll"
    }

    for name, target in pairs(
        pages
    ) do
        local data =
            NavigationButtons[name]

        if data
            and data.Button then
            Connect(
                data.Button.MouseButton1Click,
                function()
                    if not GuiFechada then
                        ShowPage(
                            target,
                            false
                        )
                    end
                end
            )
        end
    end
end

local function SetupToggles()
    if UI.AutoFarmToggle then
        Connect(
            UI.AutoFarmToggle.MouseButton1Click,
            function()
                if Running then
                    StopFarm()
                else
                    StartFarm()
                end
            end
        )
    end

    if UI.AutoFarmCard then
        Connect(
            UI.AutoFarmCard.InputBegan,
            function(input)
                if input.UserInputType ~=
                    Enum.UserInputType.MouseButton1
                    and input.UserInputType ~=
                    Enum.UserInputType.Touch then
                    return
                end

                local objects

                pcall(function()
                    objects =
                        GuiService:
                        GetGuiObjectsAtPosition(
                            input.Position.X,
                            input.Position.Y
                        )
                end)

                local clickedToggle =
                    false

                if objects then
                    for _, object in ipairs(
                        objects
                    ) do
                        pcall(function()
                            if object ==
                                UI.AutoFarmToggle
                                or object:IsDescendantOf(
                                    UI.AutoFarmToggle
                                ) then
                                clickedToggle =
                                    true
                            end
                        end)

                        if clickedToggle then
                            break
                        end
                    end
                end

                if not clickedToggle then
                    ToggleAutoFarmDetails()
                end
            end
        )
    end

    if UI.InstantToggle then
        Connect(
            UI.InstantToggle.MouseButton1Click,
            function()
                if State.InstantInteractEnabled then
                    DisableInstantInteract()
                else
                    EnableInstantInteract()
                end
            end
        )
    end

    if UI.AntiToggle then
        Connect(
            UI.AntiToggle.MouseButton1Click,
            function()
                if State.AntiDescarrilhadorEnabled then
                    DisableAntiDescarrilhador()
                else
                    EnableAntiDescarrilhador()
                end
            end
        )
    end
end

local function SetupHeaderButtons()
    if UI.MinimizeButton then
        Connect(
            UI.MinimizeButton.MouseButton1Click,
            function()
                MinimizeHub()
            end
        )
    end

    if UI.CloseButton then
        Connect(
            UI.CloseButton.MouseButton1Click,
            function()
                CloseHub()
            end
        )
    end
end

local function InitializeGui()
    UI.ScreenGui =
        CreateScreenGui()

    if not UI.ScreenGui then
        return false
    end

    CreateWindow()

    if not UI.Window then
        return false
    end

    CreateSidebar(
        UI.Window
    )

    CreateHeader(
        UI.Window
    )

    CreateContent(
        UI.Window
    )

    CreatePages()
    CreateRestorePill()
    SetupNavigation()
    SetupToggles()
    SetupHeaderButtons()
    SetupDrag()
    SetupVisibilityKey()

    ShowPage(
        "Home",
        true
    )

    SetAutoFarmToggleVisual(
        false
    )

    SetInstantToggleVisual(
        true
    )

    SetAntiToggleVisual(
        false
    )

    pcall(function()
        UI.Window.BackgroundTransparency =
            0

        UI.WindowScale.Scale =
            0.96
    end)

    CreateTween(
        UI.WindowScale,
        0.2,
        {
            Scale = 1
        }
    )

    State.OpenAnimationDone =
        true

    return true
end

