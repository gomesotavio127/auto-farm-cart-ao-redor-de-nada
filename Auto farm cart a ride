local function BeginDrag(input)
    if not UI.Window then
        return
    end

    local objects

    pcall(function()
        objects =
            GuiService:
            GetGuiObjectsAtPosition(
                input.Position.X,
                input.Position.Y
            )
    end)

    if objects then
        for _, object in ipairs(
            objects
        ) do
            if object ~=
                UI.Window
                and IsInteractiveGuiObject(
                    object
                ) then
                return
            end
        end
    end

    State.Dragging =
        true

    State.DragStart =
        input.Position

    State.StartPosition =
        UI.Window.Position

    if State.DragMoveConnection then
        DisconnectConnection(
            State.DragMoveConnection
        )

        State.DragMoveConnection =
            nil
    end

    if State.DragEndConnection then
        DisconnectConnection(
            State.DragEndConnection
        )

        State.DragEndConnection =
            nil
    end

    State.DragMoveConnection =
        Connect(
            UserInputService.InputChanged,
            function(changed)
                if not State.Dragging
                    or not UI.Window then
                    return
                end

                if changed.UserInputType ~=
                    Enum.UserInputType.MouseMovement
                    and changed.UserInputType ~=
                    Enum.UserInputType.Touch then
                    return
                end

                local delta =
                    changed.Position -
                    State.DragStart

                pcall(function()
                    UI.Window.Position =
                        UDim2.new(
                            State.StartPosition.X.Scale,
                            State.StartPosition.X.Offset +
                            delta.X,
                            State.StartPosition.Y.Scale,
                            State.StartPosition.Y.Offset +
                            delta.Y
                        )
                end)
            end,
            false
        )

    State.DragEndConnection =
        Connect(
            UserInputService.InputEnded,
            function(ended)
                if ended == input
                    or ended.UserInputType ==
                        Enum.UserInputType.MouseButton1
                    or ended.UserInputType ==
                        Enum.UserInputType.Touch then

                    State.Dragging =
                        false

                    if State.DragMoveConnection then
                        DisconnectConnection(
                            State.DragMoveConnection
                        )

                        State.DragMoveConnection =
                            nil
                    end

                    if State.DragEndConnection then
                        DisconnectConnection(
                            State.DragEndConnection
                        )

                        State.DragEndConnection =
                            nil
                    end
                end
            end,
            false
        )
end

local function SetupDrag()
    if not UI.Window then
        return
    end

    Connect(
        UI.Window.InputBegan,
        function(input)
            if input.UserInputType ==
                Enum.UserInputType.MouseButton1
                or input.UserInputType ==
                Enum.UserInputType.Touch then
                BeginDrag(input)
            end
        end
    )
end

